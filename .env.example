# 0 = com janela (Mac/dev) | 1 = headless | virtual = display virtual do Camoufox (Linux)
# No Docker o compose fixa HEADLESS=display (tela virtual espelhada por VNC, necessário p/ resolver captcha pelo dashboard)
HEADLESS=0

# Senha da API (X-Api-Token ou Authorization: Bearer). Vazio = API aberta (só dev). Gere com: openssl rand -hex 32
API_TOKEN=troque-por-um-token-forte

# URL pública da API (usada no link do noVNC), ex.: https://ml-check.suaempresa.com
PUBLIC_BASE_URL=

SLOTS=1
MIN_GAP_S=10
REQUEST_TIMEOUT_S=150
CAPTCHA_SESSION_TTL_S=900
